# Copy this file to .env for local development.
# Keep real secrets in Railway Variables (or your ignored local .env) only.

# ---- AI assistant: Dograh (self-hosted voice + chat agent) ----
# The agent itself (LLM, speech-to-text, text-to-speech) is configured inside
# your Dograh dashboard. This app only needs the two values below.
#
# Long random secret. Paste the SAME value into each Dograh HTTP tool's
# "Authorization: Bearer <value>" credential. Without it all /api/agent/* is off.
DOGRAH_TOOL_API_KEY=
# The embed <script src="..."> URL from Dograh > your agent > Settings >
# Add to Website > Configure Widget. Leave empty to hide the assistant.
DOGRAH_EMBED_SCRIPT_URL=
DOGRAH_AGENT_NAME=AI Assistant

# Optional PostgreSQL connection pool tuning; multiplied by web worker count.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Optional for shared visual-search rate limiting/cache and PostgreSQL visual
# indexing. Redis is not required for local development.
REDIS_URL=

# Optional SigLIP 2 model service. On Railway, run it as a separate private
# service so model downloads/inference do not compete with inventory requests.
PRODUCT_IMAGE_DIR=
VISUAL_AI_URL=
VISUAL_AI_API_KEY=
VISUAL_AI_TIMEOUT_SECONDS=120
VISUAL_MATCH_MIN_SCORE=0.90
VISUAL_MATCH_MIN_MARGIN=0.10
VISUAL_SEARCH_DEV_MAX_CATALOG=500
VISUAL_SEARCH_RPM=30
